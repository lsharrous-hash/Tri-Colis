# Commit sur dev
git add web/src/pages/ToursImport.tsx
git commit -m "fix: permettre création sous-traitant dans modal Cainiao"

# Push la branche dev (optionnel, pour backup sur GitHub)
git push -u origin dev

# Revenir sur main
git checkout main

# Merger dev dans main
git merge dev

# Push vers prod (Render redéploie)
git push origin main

